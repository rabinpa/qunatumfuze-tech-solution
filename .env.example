# Environment Variables for QuantumFuze Tech Solutions
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local or any file containing real secrets

# ─── Site Configuration ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database (PostgreSQL) ───────────────────────────────────────────────
# Format: postgresql://user:password@host:5432/database
# For Cloudflare production, use a serverless PostgreSQL provider (Neon, Supabase)
# Supabase: use the connection pooler string (port 6543) as DATABASE_URL
# Neon: use the connection pooling URL
DATABASE_URL=

# ─── Email (Resend) ──────────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
FROM_EMAIL=noreply@quantumfuze.com
CONTACT_NOTIFICATION_EMAIL=hello@quantumfuze.com

# ─── Cloudflare Turnstile (spam protection) ─────────────────────────────
# https://dash.cloudflare.com/sign-up/turnstile
# Public key is safe to expose (used client-side)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key is server-side only
TURNSTILE_SECRET_KEY=

# ─── Rate Limiting (Production) ─────────────────────────────────────────
# For multi-instance Cloudflare deployments, use Upstash Redis
# Leave empty to use in-memory rate limiting (dev only)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ─── Cloudflare (for deployment) ─────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=


