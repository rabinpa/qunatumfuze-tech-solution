# Environment Variables for QuantumFuze Tech Solutions
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local or any file containing real secrets

# ─── Site Configuration ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database (PostgreSQL) ───────────────────────────────────────────────
# Format: postgresql://user:password@host:5432/database
# For Cloudflare production, use a serverless PostgreSQL provider (Neon, Supabase)
# Supabase: use the connection pooler string (port 6543) as DATABASE_URL
DATABASE_URL=postgresql://user:password@localhost:5432/quantumfuze

# ─── Email (Resend) ──────────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@quantumfuze.com
NOTIFICATION_EMAIL=team@quantumfuze.com

# ─── Cloudflare Turnstile (spam protection) ─────────────────────────────
# https://dash.cloudflare.com/sign-up/turnstile
# Public key is safe to expose (used client-side)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key is server-side only
TURNSTILE_SECRET_KEY=

# ─── Cloudflare (for deployment) ─────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

